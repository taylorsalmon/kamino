{
  "name": "claude-fleet",
  "version": "0.1.0",
  "description": "Desktop manager for Claude Code instances — embedded terminals + live fleet status",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
